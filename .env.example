# 웅이연구소 환경변수 목록
# 사용 방법: cp .env.example .env.local
# .env.local과 실제 인증 키는 Git에 올리지 마세요.
# Vercel Production은 Vercel 프로젝트 설정 > Environment Variables에서 별도로 입력합니다.

# ── 검색엔진 공개 ────────────────────────────────────────────────
# 서비스 공개/검증을 마친 뒤 true로 변경하세요.
# false: 검색 색인 차단, 비어 있는 사이트맵, RSS 404
NEXT_PUBLIC_LAUNCH_READY=false

# 광고 스크립트를 실제로 켤 때만 true. 개인정보 고지·지역별 동의 설정을 먼저 확인하세요.
NEXT_PUBLIC_ADSENSE_ENABLED=false

# 네이버 서치어드바이저 소유권 확인 HTML 메타태그의 content 값.
# 코드에도 동일한 기본값이 있으므로 변경할 때만 수정해도 됩니다.
NAVER_SITE_VERIFICATION=07035e99a992fee454944a610d2421460f59743d

# Google Search Console에서 발급한 google-site-verification의 content 값.
# 아직 발급받지 않았다면 비워 두세요.
GOOGLE_SITE_VERIFICATION=

# ── Google AdSense (선택) ──────────────────────────────────────────
# AdSense 계정의 실제 게시자 ID (ca-pub- 다음에 숫자 16자리).
# 발급 전에는 비워 두세요. 유효하면 계정 메타태그와 ads.txt가 생성됩니다.
ADSENSE_PUBLISHER_ID=

# ── Supabase (선택) ────────────────────────────────────────────────
# Supabase Project Settings > API > Project URL
# 비워 두면 저장소의 기본 도구 목록을 사용합니다.
SUPABASE_URL=

# 권장: Supabase Project API의 sb_publishable_ 공개 키.
# 이 프로젝트의 서버 API가 Supabase와 통신할 때 사용합니다.
SUPABASE_PUBLISHABLE_KEY=

# 구버전 Supabase 프로젝트에서 publishable 키 대신 사용하는 anon JWT (대체용).
# SUPABASE_PUBLISHABLE_KEY가 설정되어 있으면 그 값이 우선합니다.
# SUPABASE_ANON_KEY=

# 선택: Supabase 사용량 집계 쓰기용 비밀 키. 서버에서만 사용합니다.
# 절대 NEXT_PUBLIC_ 접두사를 붙이지 마세요.
# SUPABASE_ANALYTICS_SECRET_KEY=
