# Supabase Project Settings > API > Project URL
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Use the safe public sb_publishable_... key. This is used only by our server REST proxy.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
# Older projects can use SUPABASE_ANON_KEY=eyJ... (legacy anon JWT) instead.
# Catalog reads only use a public key. Optional usage analytics (server-only):
# SUPABASE_ANALYTICS_SECRET_KEY=sb_secret_YOUR_SECRET
# Use the project secret key only on the server; never prefix it with NEXT_PUBLIC_.
# Run supabase/003_tool_popularity.sql before enabling visits.
# Leave launch flag unset until all 11 tools pass QA.
# NEXT_PUBLIC_LAUNCH_READY=true
